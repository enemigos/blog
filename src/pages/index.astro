---
import { getCollection } from "astro:content";
import "../styles/global.css";
import BaseLayout from "../layouts/BaseLayout.astro";

const SITE_NAME = "reno (rené cáceres)";
const SITE_BLURB = "colección de notas para mi familia y amigos.";

const LOOP_VIDEOS = [
  { src: "/video/mvi-6416.mp4", poster: "/video/mvi-6416-poster.jpg" },
  { src: "/video/important.mp4", poster: undefined },
  { src: "/video/img-0179.mp4", poster: undefined },
];

const formatMonthYear = (date: Date): string =>
  date.toLocaleDateString("es-ES", { month: "numeric" }) +
  ", " +
  date.getFullYear();

const posts = (await getCollection("blog"))
  .filter((post) => !post.data.hidden)
  .sort((a, b) => b.data.pubDate.getTime() - a.data.pubDate.getTime());
---

<BaseLayout title={SITE_NAME} description={SITE_BLURB}>
  <header>
    <h1>{SITE_NAME}</h1>
    <p class="text-typography-200">{SITE_BLURB}</p>
  </header>

  <div class="relative aspect-video overflow-hidden rounded bg-foreground-300">
    {
      LOOP_VIDEOS.map(({ src, poster }, index) => (
        <video
          data-loop-video
          data-src={src}
          poster={poster}
          muted
          playsinline
          preload="auto"
          class:list={[
            "absolute inset-0 size-full object-cover",
            { invisible: index !== 0 },
          ]}
        />
      ))
    }
  </div>

  <section>
    <h2 class="text-typography-200">colecciones</h2>
    <ul>
      {
        posts.map((post) => (
          <li>
            <a href={`/${post.id}`} class="hover:text-primary">
              {post.data.title}.{" "}
              <time class="text-typography-200">
                {formatMonthYear(post.data.pubDate)}
              </time>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</BaseLayout>

<script>
  const getNextIndex = (currentIndex: number, total: number): number =>
    (currentIndex + 1) % total;

  const showOnlyVideoAt = (videos: HTMLVideoElement[], activeIndex: number) =>
    videos.forEach((video, index) =>
      video.classList.toggle("invisible", index !== activeIndex)
    );

  const getLoopVideos = (): HTMLVideoElement[] =>
    Array.from(document.querySelectorAll<HTMLVideoElement>("[data-loop-video]"));

  const prefersReducedMotion = (): boolean =>
    window.matchMedia("(prefers-reduced-motion: reduce)").matches;

  const retryPlayWhenAllowed = (video: HTMLVideoElement) => {
    const retry = () => void video.play().catch(() => undefined);
    video.addEventListener("canplay", retry, { once: true });
    window.addEventListener("pointerdown", retry, { once: true, capture: true });
  };

  const playMuted = (video: HTMLVideoElement) => {
    video.muted = true;
    video.playsInline = true;
    video.play().catch(() => retryPlayWhenAllowed(video));
  };

  const playVideoAt = (videos: HTMLVideoElement[], index: number) => {
    videos[index].currentTime = 0;
    showOnlyVideoAt(videos, index);
    playMuted(videos[index]);
  };

  const resumeVisibleVideo = () => {
    const visibleVideo = getLoopVideos().find(
      (video) => !video.classList.contains("invisible")
    );
    const shouldResume =
      visibleVideo !== undefined &&
      visibleVideo.paused &&
      document.visibilityState === "visible" &&
      !prefersReducedMotion();

    if (shouldResume) playMuted(visibleVideo);
  };

  const attachSource = (video: HTMLVideoElement) => {
    const { src } = video.dataset;
    if (src !== undefined && video.getAttribute("src") !== src) video.src = src;
  };

  const startLoop = () => {
    const videos = getLoopVideos();

    if (videos.length === 0 || prefersReducedMotion()) return;

    videos.forEach(attachSource);
    videos.forEach((video, index) =>
      video.addEventListener("ended", () =>
        playVideoAt(videos, getNextIndex(index, videos.length))
      )
    );
    playVideoAt(videos, 0);
  };

  document.addEventListener("astro:page-load", startLoop);
  document.addEventListener("visibilitychange", resumeVisibleVideo);
  window.addEventListener("pageshow", (event) => {
    if (event.persisted) resumeVisibleVideo();
  });
</script>
